import discord
from discord.ext import commands, tasks
import sqlite3
import datetime
import pytz
import random
import asyncio
import os
import aiohttp
from PIL import Image, ImageDraw, ImageFont, ImageOps, features
import arabic_reshaper
from bidi.algorithm import get_display
from dotenv import load_dotenv

# تحميل المتغيرات السرية
load_dotenv()

# --- إعداد التوقيت (توقيت السعودية) ---
KSA_TZ = pytz.timezone('Asia/Riyadh')
def get_now():
    return datetime.datetime.now(KSA_TZ)

# --- دالة تحويل الألوان ---
def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    return tuple(int(hex_str[i:i+2], 16) for i in (0, 2, 4))

# --- إعداد قاعدة البيانات (جديدة ونظيفة) ---
conn = sqlite3.connect('economy.db')
cursor = conn.cursor()

cursor.execute('''
    CREATE TABLE IF NOT EXISTS users (
        user_id INTEGER PRIMARY KEY,
        balance INTEGER DEFAULT 0,
        level INTEGER DEFAULT 1,
        xp INTEGER DEFAULT 0,
        last_daily TEXT DEFAULT '2000-01-01',
        last_card_draw TEXT DEFAULT '2000-01-01',
        last_msg TEXT DEFAULT '',
        last_msg_time REAL DEFAULT 0.0,
        spam_penalty_until REAL DEFAULT 0.0,
        active_background INTEGER DEFAULT NULL,
        cards_count INTEGER DEFAULT 0
    )
''')

cursor.execute('''
    CREATE TABLE IF NOT EXISTS settings (
        id INTEGER PRIMARY KEY,
        event_pool INTEGER DEFAULT 30000,
        last_pool_reset TEXT DEFAULT '2000-01-01'
    )
''')
cursor.execute("INSERT OR IGNORE INTO settings (id, event_pool) VALUES (1, 30000)")

cursor.execute('''
    CREATE TABLE IF NOT EXISTS backgrounds (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT UNIQUE,
        price INTEGER,
        image_path TEXT,
        rarity TEXT DEFAULT 'عادية',
        ui_color TEXT DEFAULT '#87a2b3'
    )
''')

cursor.execute('''
    CREATE TABLE IF NOT EXISTS user_backgrounds (
        user_id INTEGER,
        background_id INTEGER,
        PRIMARY KEY (user_id, background_id),
        FOREIGN KEY (user_id) REFERENCES users(user_id),
        FOREIGN KEY (background_id) REFERENCES backgrounds(id)
    )
''')
cursor.execute("INSERT OR IGNORE INTO backgrounds (name, price, image_path, rarity, ui_color) VALUES ('الافتراضية', 0, 'assets/bg_default.png', 'أساسية', '#87a2b3')")
conn.commit()

# --- إعدادات البوت ---
intents = discord.Intents.default()
intents.message_content = True
intents.members = True
bot = commands.Bot(command_prefix="!", intents=intents)

# --- تحميل الخط العربي ---
async def download_font():
    if not os.path.exists('Tajawal-Bold.ttf'):
        print("جاري تحميل الخط العربي...")
        try:
            url = "https://github.com/google/fonts/raw/main/ofl/tajawal/Tajawal-Bold.ttf"
            async with aiohttp.ClientSession() as session:
                async with session.get(url) as response:
                    if response.status == 200:
                        with open("Tajawal-Bold.ttf", "wb") as f:
                            f.write(await response.read())
                        print("تم تحميل الخط بنجاح!")
        except Exception as e:
            print(f"فشل تحميل الخط: {e}")

@bot.event
async def on_ready():
    print(f"تم تسجيل الدخول بنجاح باسم {bot.user}")
    print(f"دعم اللغة العربية (libraqm): {features.check('raqm')}") # لمعرفة هل المستضيف يدعم العربي
    await bot.change_presence(activity=discord.Game(name="/فلوس | Aki Bot"))
    bot.loop.create_task(download_font())
    reset_event_pool.start()

@tasks.loop(minutes=1)
async def reset_event_pool():
    today = str(get_now().date())
    cursor.execute("SELECT last_pool_reset FROM settings WHERE id = 1")
    last_reset = cursor.fetchone()[0]
    if last_reset != today:
        cursor.execute("UPDATE settings SET event_pool = 30000, last_pool_reset = ? WHERE id = 1", (today,))
        conn.commit()

def get_user(user_id):
    cursor.execute("SELECT * FROM users WHERE user_id = ?", (user_id,))
    user = cursor.fetchone()
    if user is None:
        cursor.execute("INSERT INTO users (user_id, balance) VALUES (?, ?)", (user_id, 500))
        conn.commit()
        cursor.execute("SELECT * FROM users WHERE user_id = ?", (user_id,))
        user = cursor.fetchone()
    return user

# --- الدالة الذكية لكتابة النص العربي ---
def draw_arabic_text(draw, text, position, font, fill, anchor="mm"):
    if features.check("raqm"):
        # إذا كان المستضيف يدعم الخط العربي، اكتبه مباشرة
        draw.text(position, str(text), font=font, fill=fill, anchor=anchor)
    else:
        # إذا لم يكن يدعمه، استخدم المعالجة اليدوية
        reshaped_text = arabic_reshaper.reshape(str(text))
        bidi_text = get_display(reshaped_text)
        draw.text(position, bidi_text, font=font, fill=fill, anchor=anchor)

# ==========================================
# 🛡️ نظام السبام والرسائل
# ==========================================
@bot.event
async def on_message(message):
    if message.author.bot: return
    get_user(message.author.id)
    now_time = get_now().timestamp()

    cursor.execute("SELECT balance, xp, level, last_msg, last_msg_time, spam_penalty_until FROM users WHERE user_id = ?", (message.author.id,))
    user = cursor.fetchone()
    bal, xp, level, last_msg, last_time, spam_until = user

    if now_time < spam_until:
        await bot.process_commands(message)
        return

    if message.content == last_msg and (now_time - last_time) < 60:
        cursor.execute("UPDATE users SET balance = balance - 15, spam_penalty_until = ?, last_msg = ?, last_msg_time = ? WHERE user_id = ?", (now_time + 180, message.content, now_time, message.author.id))
        conn.commit()
        await message.channel.send(f"⚠️ {message.author.mention} ممنوع السبام! تم سحب نقاط رسالتك السابقة وحرمانك من العملات لمدة 3 دقائق.", delete_after=5)
        await bot.process_commands(message)
        return

    coins_to_add = 15
    if "فن-وابداع" in message.channel.name and message.attachments:
        if any(att.content_type and att.content_type.startswith('image/') for att in message.attachments):
            coins_to_add = 30

    xp_to_add = 1 if coins_to_add == 15 else 2
    new_bal = bal + coins_to_add
    new_xp = xp + xp_to_add
    new_level = level

    if new_xp >= 1000 * new_level:
        new_level += 1
        new_xp = 0
        level_reward = new_level * 100
        new_bal += level_reward
        await message.channel.send(f"🎉 مبروك {message.author.mention}! لقد وصلت للمستوى **{new_level}** وحصلت على **{level_reward}** عملة!")

    cursor.execute("UPDATE users SET balance = ?, xp = ?, level = ?, last_msg = ?, last_msg_time = ? WHERE user_id = ?", (new_bal, new_xp, new_level, message.content, now_time, message.author.id))
    conn.commit()
    await bot.process_commands(message)

# ==========================================
# 💰 أوامر البنك
# ==========================================
@bot.hybrid_command(name="فلوس", description="استلم 50 عملة يومياً")
async def daily(ctx):
    get_user(ctx.author.id)
    today = str(get_now().date())
    cursor.execute("SELECT last_daily FROM users WHERE user_id = ?", (ctx.author.id,))
    last_daily = cursor.fetchone()[0]
    if last_daily == today:
        await ctx.send(f"⏳ {ctx.author.mention}، لقد استلمت فلوسك اليوم بالفعل!", ephemeral=True)
    else:
        cursor.execute("UPDATE users SET balance = balance + 50, last_daily = ? WHERE user_id = ?", (today, ctx.author.id))
        conn.commit()
        await ctx.send(f"💰 مبروك {ctx.author.mention}! لقد استلمت **50** عملة اليومية.")

@bot.hybrid_command(name="حسابي", description="عرض ملفك الشخصي كصورة")
async def profile(ctx):
    await ctx.defer() 
    get_user(ctx.author.id)
    
    cursor.execute("SELECT balance, level, xp, active_background, cards_count FROM users WHERE user_id = ?", (ctx.author.id,))
    bal, level, xp, active_bg, cards_count = cursor.fetchone()
    
    if not active_bg:
        cursor.execute("SELECT image_path, ui_color FROM backgrounds WHERE rarity = 'أساسية' LIMIT 1")
        result = cursor.fetchone()
        bg_path = result[0] if result else 'assets/bg_default.png'
        ui_color_hex = result[1] if result else '#87a2b3'
    else:
        cursor.execute("SELECT image_path, ui_color FROM backgrounds WHERE id = ?", (active_bg,))
        result = cursor.fetchone()
        bg_path = result[0]
        ui_color_hex = result[1] if result[1] else '#87a2b3'
    
    avatar_asset = ctx.author.display_avatar.replace(size=256, format='png')
    avatar_data = await avatar_asset.read()
    avatar_path = f"temp_avatar_{ctx.author.id}.png"
    with open(avatar_path, 'wb') as f:
        f.write(avatar_data)

    def generate_image():
        if not os.path.exists(bg_path):
            bg_img = Image.new('RGB', (1080, 1080), color=(255, 255, 255))
        else:
            bg_img = Image.open(bg_path).convert('RGBA')
        
        bg_img = ImageOps.fit(bg_img, (1080, 1080), centering=(0.5, 0.5))
        draw = ImageDraw.Draw(bg_img, 'RGBA')
        
        rgb = hex_to_rgb(ui_color_hex)
        ui_color = (rgb[0], rgb[1], rgb[2], 200)
        
        # رسم الأشكال
        draw.rectangle([70, 210, 630, 390], fill=ui_color)
        draw.ellipse([700, 100, 1020, 420], fill=ui_color)
        draw.polygon([(80, 450), (700, 450), (650, 570), (80, 570)], fill=ui_color)
        draw.polygon([(80, 610), (700, 610), (650, 730), (80, 730)], fill=ui_color)
        draw.polygon([(80, 770), (700, 770), (650, 890), (80, 890)], fill=ui_color)
        
        try:
            font_title = ImageFont.truetype("Tajawal-Bold.ttf", 60)
            font_text = ImageFont.truetype("Tajawal-Bold.ttf", 50)
        except:
            font_title = ImageFont.load_default()
            font_text = ImageFont.load_default()
        
        # لصق الأفاتار
        avatar_img = Image.open(avatar_path).convert('RGBA')
        avatar_img = avatar_img.resize((270, 270))
        mask = Image.new('L', (270, 270), 0)
        mask_draw = ImageDraw.Draw(mask)
        mask_draw.ellipse((0, 0, 270, 270), fill=255)
        bg_img.paste(avatar_img, (725, 115), mask=mask)
        
        # كتابة النصوص
        draw_arabic_text(draw, ctx.author.name, (350, 300), font_title, (20, 20, 20))
        
        draw_arabic_text(draw, "رصيدي", (650, 510), font_text, (20, 20, 20), anchor="rm")
        draw_arabic_text(draw, str(bal), (390, 510), font_text, (20, 20, 20), anchor="mm")
        
        draw_arabic_text(draw, "المستوى", (650, 670), font_text, (20, 20, 20), anchor="rm")
        draw_arabic_text(draw, str(level), (390, 670), font_text, (20, 20, 20), anchor="mm")
        
        draw_arabic_text(draw, "البطاقات", (650, 830), font_text, (20, 20, 20), anchor="rm")
        draw_arabic_text(draw, str(cards_count), (390, 830), font_text, (20, 20, 20), anchor="mm")
        
        output_path = f"profile_{ctx.author.id}.png"
        bg_img.save(output_path)
        return output_path

    try:
        output_path = await asyncio.to_thread(generate_image)
        file = discord.File(output_path, filename="profile.png")
        await ctx.send(file=file)
    except Exception as e:
        print(f"خطأ: {e}")
        await ctx.send(f"❌ حدث خطأ: {e}", ephemeral=True)
    finally:
        if os.path.exists(avatar_path): os.remove(avatar_path)
        if os.path.exists(f"profile_{ctx.author.id}.png"): os.remove(f"profile_{ctx.author.id}.png")

@bot.hybrid_command(name="ايداع", description="تحويل عملات")
async def transfer(ctx, member: discord.Member, amount: int):
    if amount <= 0 or member == ctx.author or member.bot:
        return await ctx.send("❌ خطأ.", ephemeral=True)
    get_user(ctx.author.id)
    get_user(member.id)
    cursor.execute("SELECT balance FROM users WHERE user_id = ?", (ctx.author.id,))
    if cursor.fetchone()[0] < amount:
        return await ctx.send("❌ رصيدك غير كافٍ!", ephemeral=True)
    cursor.execute("UPDATE users SET balance = balance - ? WHERE user_id = ?", (amount, ctx.author.id))
    cursor.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (amount, member.id))
    conn.commit()
    await ctx.send(f"✅ تم تحويل **{amount}** عملة إلى {member.mention}.")

# ==========================================
# 🎲 أمر السحب
# ==========================================
@bot.hybrid_command(name="اسحب", description="سحب بطاقة أو خلفية عشوائية")
async def draw_card(ctx):
    get_user(ctx.author.id)
    today = str(get_now().date())
    cursor.execute("SELECT balance, last_card_draw FROM users WHERE user_id = ?", (ctx.author.id,))
    bal, last_draw = cursor.fetchone()
    
    if last_draw == today:
        if bal < 2000:
            return await ctx.send("❌ السحب المجاني انتهى. تحتاج 2000 عملة للسحب.", ephemeral=True)
        cursor.execute("UPDATE users SET balance = balance - 2000 WHERE user_id = ?", (ctx.author.id,))
        conn.commit()
        await ctx.send("💸 تم خصم 2000 عملة. جاري السحب...")
    else:
        cursor.execute("UPDATE users SET last_card_draw = ? WHERE user_id = ?", (today, ctx.author.id))
        conn.commit()
        await ctx.send("🎁 لقد استخدمت سحبك المجاني اليومي! جاري السحب...")
    
    if random.random() < 0.10:
        cursor.execute("""
            SELECT id, name FROM backgrounds 
            WHERE price > 0 
            AND id NOT IN (SELECT background_id FROM user_backgrounds WHERE user_id = ?) 
            ORDER BY RANDOM() LIMIT 1
        """, (ctx.author.id,))
        bg = cursor.fetchone()
        
        if bg:
            bg_id, bg_name = bg
            cursor.execute("INSERT INTO user_backgrounds (user_id, background_id) VALUES (?, ?)", (ctx.author.id, bg_id))
            conn.commit()
            await ctx.send(f"🎉 **مبروك!** لقد حصلت على خلفية جديدة: **{bg_name}**!\nيمكنك تفعيلها باستخدام الأمر: `/خلفيتي {bg_name}`")
            return

    rarities = ["عادية", "متوسطة", "نادرة", "أسطورية"]
    chance = random.random()
    if chance > 0.95: card = rarities[3]
    elif chance > 0.80: card = rarities[2]
    elif chance > 0.50: card = rarities[1]
    else: card = rarities[0]
    
    await ctx.send(f"🎴 مبروك! لقد سحبت بطاقة **{card}**! (سيتم إضافة أسماء الشخصيات لاحقاً).")

# ==========================================
# 👑 أوامر الإدارة
# ==========================================
@bot.hybrid_command(name="سحب", description="سحب عملات من البنك (للمسؤول فقط)")
@commands.has_permissions(administrator=True)
async def admin_withdraw(ctx, amount: int):
    get_user(ctx.author.id)
    cursor.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (amount, ctx.author.id))
    conn.commit()
    await ctx.send(f"👑 تم سحب **{amount}** عملة من البنك وإضافتها لرصيدك.")

@bot.hybrid_command(name="خصم", description="خصم عملات من عضو (للمسؤول فقط)")
@commands.has_permissions(administrator=True)
async def admin_deduct(ctx, member: discord.Member, amount: int):
    if amount <= 0: 
        return await ctx.send("❌ يجب أن يكون المبلغ أكبر من صفر.", ephemeral=True)
    
    get_user(member.id)
    cursor.execute("SELECT balance FROM users WHERE user_id = ?", (member.id,))
    current_bal = cursor.fetchone()[0]
    
    if current_bal < amount:
        cursor.execute("UPDATE users SET balance = 0 WHERE user_id = ?", (member.id,))
        conn.commit()
        await ctx.send(f"⚠️ رصيد {member.mention} كان أقل من المبلغ المطلوب. تم تصفير رصيده بالكامل (تم خصم {current_bal} عملة).")
    else:
        cursor.execute("UPDATE users SET balance = balance - ? WHERE user_id = ?", (amount, member.id))
        conn.commit()
        await ctx.send(f"✅ تم خصم **{amount}** عملة من رصيد {member.mention} بنجاح.")

@bot.hybrid_command(name="مكافأة", description="إعطاء مكافأة فعاليات")
@commands.has_permissions(manage_messages=True)
async def event_reward(ctx, member: discord.Member, amount: int):
    cursor.execute("SELECT event_pool FROM settings WHERE id = 1")
    pool = cursor.fetchone()[0]
    if pool < amount: return await ctx.send("❌ الصندوق فارغ!", ephemeral=True)
    cursor.execute("UPDATE settings SET event_pool = event_pool - ? WHERE id = 1", (amount,))
    get_user(member.id)
    cursor.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (amount, member.id))
    conn.commit()
    await ctx.send(f"🏆 تم إعطاء **{amount}** لـ {member.mention}.")

@bot.hybrid_command(name="زيادة", description="زيادة صندوق الفعاليات")
@commands.has_permissions(administrator=True)
async def add_pool(ctx, amount: int):
    cursor.execute("UPDATE settings SET event_pool = event_pool + ? WHERE id = 1", (amount,))
    conn.commit()
    await ctx.send(f"💳 تم زيادة الصندوق بـ **{amount}**.")

# ==========================================
# 🛍️ المتجر والخلفيات
# ==========================================
@bot.hybrid_command(name="متجر_الخلفيات", description="عرض الخلفيات")
async def bg_shop(ctx):
    cursor.execute("SELECT name, price, rarity FROM backgrounds WHERE price > 0")
    bgs = cursor.fetchall()
    if not bgs: return await ctx.send("المتجر فارغ.")
    embed = discord.Embed(title="🛍️ المتجر", color=discord.Color.purple())
    for name, price, rarity in bgs:
        embed.add_field(name=f"{name} ({rarity})", value=f"السعر: **{price}**", inline=False)
    await ctx.send(embed=embed)

@bot.hybrid_command(name="شراء_خلفية", description="شراء خلفية")
async def buy_bg(ctx, name: str):
    cursor.execute("SELECT id, price FROM backgrounds WHERE name = ?", (name,))
    bg = cursor.fetchone()
    if not bg: return await ctx.send("❌ غير موجودة.", ephemeral=True)
    bg_id, price = bg
    if cursor.execute("SELECT 1 FROM user_backgrounds WHERE user_id = ? AND background_id = ?", (ctx.author.id, bg_id)).fetchone():
        return await ctx.send("❌ تملكها بالفعل.", ephemeral=True)
    cursor.execute("SELECT balance FROM users WHERE user_id = ?", (ctx.author.id,))
    if cursor.fetchone()[0] < price: return await ctx.send("❌ رصيدك غير كافٍ.", ephemeral=True)
    cursor.execute("UPDATE users SET balance = balance - ? WHERE user_id = ?", (price, ctx.author.id))
    cursor.execute("INSERT INTO user_backgrounds (user_id, background_id) VALUES (?, ?)", (ctx.author.id, bg_id))
    conn.commit()
    await ctx.send(f"✅ اشتريت **{name}**.")

@bot.hybrid_command(name="خلفيتي", description="تغيير الخلفية")
async def set_bg(ctx, name: str):
    cursor.execute("SELECT b.id FROM backgrounds b JOIN user_backgrounds ub ON b.id = ub.background_id WHERE ub.user_id = ? AND b.name = ?", (ctx.author.id, name))
    bg = cursor.fetchone()
    if not bg:
        cursor.execute("SELECT id FROM backgrounds WHERE name = ? AND rarity = 'أساسية'", (name,))
        bg = cursor.fetchone()
    if not bg: return await ctx.send("❌ لا تملكها.", ephemeral=True)
    cursor.execute("UPDATE users SET active_background = ? WHERE user_id = ?", (bg[0], ctx.author.id))
    conn.commit()
    await ctx.send(f"✅ تم تفعيل **{name}**.")

@bot.hybrid_command(name="اضف_خلفية", description="إضافة خلفية جديدة (للمسؤول)")
@commands.has_permissions(administrator=True)
async def add_background(ctx, name: str, price: int, rarity: str, attachment: discord.Attachment, ui_color: str = "#87a2b3"):
    await ctx.defer(ephemeral=True)
    try:
        if not attachment.filename.lower().endswith(('.png', '.jpg', '.jpeg')):
            return await ctx.send("❌ يجب أن تكون الصورة بصيغة png أو jpg.", ephemeral=True)
        
        if not os.path.exists('assets'): 
            os.makedirs('assets')
            
        filepath = f"assets/bg_{name}.png"
        await attachment.save(filepath)
        
        cursor.execute("INSERT INTO backgrounds (name, price, image_path, rarity, ui_color) VALUES (?, ?, ?, ?, ?)", (name, price, filepath, rarity, ui_color))
        conn.commit()
        await ctx.send(f"✅ تم إضافة الخلفية **{name}**.\nالسعر: {price}\nالندرة: {rarity}\nلون المربعات: `{ui_color}`")
    except Exception as e:
        await ctx.send(f"❌ حدث خطأ: {e}", ephemeral=True)

@bot.command()
@commands.is_owner()
async def sync(ctx):
    await bot.tree.sync()
    await ctx.send("✅ تمت المزامنة!")

# --- تشغيل البوت ---
bot.run(os.getenv('DISCORD_TOKEN')
